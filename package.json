{
  "name": "@eventra_dev/cli-plugin-vue",
  "version": "1.1.1",
  "description": "Eventra CLI plugin — extract track() calls from Vue SFC (.vue) files",
  "license": "MIT",
  "author": {
    "name": "and-1991",
    "url": "https://github.com/and-1991"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/and-1991/eventra-cli-plugin-vue"
  },
  "homepage": "https://eventra.dev",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "@vue/compiler-core": "^3.5.40",
    "@vue/compiler-dom": "^3.5.40",
    "@vue/compiler-sfc": "^3.5.40"
  },
  "devDependencies": {
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^4.1.7",
    "typescript": "^5.3.0",
    "vitest": "^4.1.7"
  },
  "keywords": [
    "eventra",
    "eventra-cli",
    "vue",
    "vue3",
    "nuxt",
    "sfc",
    "static-analysis",
    "analytics",
    "plugin"
  ],
  "publishConfig": {
    "access": "public"
  }
}
